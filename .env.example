# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Key (for receipt vision OCR and smart distance understanding)
GEMINI_API_KEY=your_gemini_api_key_here

# Your Telegram User ID (optional, to restrict bot access only to you)
AUTHORIZED_USER_ID=

# Default Origin Address & Rate per KM
ORIGIN_ADDRESS=הכ"ג 5, הרצליה
RATE_PER_KM=1.40

# Turso Cloud SQLite (optional - for permanent cloud storage)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

